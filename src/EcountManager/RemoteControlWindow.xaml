<Window x:Class="EcountManager.RemoteControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ecount Manager 리모컨" Icon="Assets/EcountManager.ico"
        Width="310" Height="218" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="RemoteButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#19335F"/>
            <Setter Property="BorderBrush" Value="#DCE4F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="#102A5C" BorderBrush="#31558F" BorderThickness="2" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border CornerRadius="16,16,0,0" Background="#17376B" MouseLeftButtonDown="Header_OnMouseLeftButtonDown" Cursor="SizeAll">
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="17" Background="#F79009" Margin="0,0,10,0">
                            <TextBlock Text="◆" Foreground="White" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="ECOUNT REMOTE" Foreground="White" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="드래그해서 원하는 곳에 두세요" Foreground="#AFC6F4" FontSize="9"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Click="Exit_OnClick" Width="32" Height="30"
                            Padding="0" Background="Transparent" Foreground="White" FontSize="18" ToolTip="앱 전체 종료"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14,13,14,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button x:Name="ManagerButton" Click="ToggleManager_OnClick" Style="{StaticResource RemoteButton}">
                    <StackPanel>
                        <TextBlock Text="▦" FontSize="25" HorizontalAlignment="Center" Foreground="#2457D6"/>
                        <TextBlock Text="Ecount Manager" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <TextBlock x:Name="ManagerStatus" Text="꺼짐 · 클릭해서 켜기" FontSize="9" Foreground="#7A8799" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="MemoButton" Grid.Column="2" Click="ToggleMemo_OnClick" Style="{StaticResource RemoteButton}">
                    <StackPanel>
                        <TextBlock Text="✦" FontSize="25" HorizontalAlignment="Center" Foreground="#F79009"/>
                        <TextBlock Text="메모 친구들" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <TextBlock x:Name="MemoStatus" Text="꺼짐 · 클릭해서 켜기" FontSize="9" Foreground="#7A8799" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock x:Name="ShortcutHint" Grid.Row="2" Text="Ctrl+1 Ecount · Ctrl+2 메모 · Ctrl+3 투명" Foreground="#AFC6F4"
                       FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        </Grid>
    </Border>
</Window>
