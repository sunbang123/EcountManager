<Window x:Class="EcountManager.SnippetFillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="복붙 문장 빈칸 채우기" Icon="Assets/EcountManager.ico"
        Width="460" SizeToContent="Height" MaxHeight="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F6F7FB" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Foreground="#1F2A44"/>
            <TextBlock Text="등록할 때 넣은 `` 순서대로 내용을 채워주세요."
                       Foreground="#667085" FontSize="11" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E2E7F0" BorderThickness="1"
                CornerRadius="8" Padding="12" Margin="0,14,0,12">
            <TextBlock x:Name="TemplateText" TextWrapping="Wrap" Foreground="#344054"/>
        </Border>

        <ScrollViewer Grid.Row="2" MaxHeight="360" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FieldsPanel"/>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Content="취소" Click="Cancel_OnClick" Margin="0,0,6,0" Background="#7A8799"/>
            <Button Grid.Column="1" Content="완성 문장 복사" Click="Copy_OnClick" Margin="6,0,0,0"/>
        </Grid>
    </Grid>
</Window>
