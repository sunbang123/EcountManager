<Window x:Class="EcountManager.MemoWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="메모 친구" Icon="Assets/EcountManager.ico"
        Width="480" Height="780" MinWidth="420" MinHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E9EEF7"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#FDECEC"/>
            <Setter Property="Foreground" Value="#B42318"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,9"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="ExpandedRoot" Background="#F8F9FC" BorderBrush="#F5B041" BorderThickness="2" CornerRadius="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#F79009" CornerRadius="15,15,0,0" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                    <Grid Margin="18,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" Background="#FFF3D6" CornerRadius="18" Margin="0,0,10,0">
                                <TextBlock Text="✦" FontSize="18" Foreground="#B54708" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="메모 친구들" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="상담 · 복붙 · 업무를 한곳에서" Foreground="#FFF0CF" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl Grid.Row="1" Margin="12,10,12,6" BorderThickness="0" Background="Transparent">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="☎" FontSize="15" Margin="0,0,6,0"/><TextBlock Text="상담 친구"/></StackPanel>
                        </TabItem.Header>
                        <Grid Margin="4,10,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="White" BorderBrush="#E2E7F0" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="상호명 *" Foreground="#667085" FontSize="10" Margin="1,0,0,4"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}" Padding="9,7"/>
                                                <Button Grid.Column="1" Content="복사" Command="{Binding CopyBusinessNameCommand}"
                                                        Background="#5C6AC4" Padding="8,7" Margin="5,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                            <TextBlock Text="전화번호" Foreground="#667085" FontSize="10" Margin="1,0,0,4"/>
                                            <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Padding="9,7"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="사업자등록번호" Foreground="#667085" FontSize="10" Margin="1,0,0,4"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding BusinessRegistrationNumber, UpdateSourceTrigger=PropertyChanged}" Padding="9,7"
                                                 ToolTip="예: 123-45-67890"/>
                                        <Button Grid.Column="1" Content="복사" Command="{Binding CopyBusinessRegistrationNumberCommand}"
                                                Background="#5C6AC4" Padding="8,7" Margin="5,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="문의내용 *" Foreground="#667085" FontSize="10" Margin="1,0,0,4"/>
                                    <TextBox Text="{Binding Inquiry, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="76" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Padding="9,7"/>
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Button Content="새 메모" Command="{Binding NewMemoCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,4,0"/>
                                        <Button Grid.Column="1" Content="저장" Command="{Binding SaveMemoCommand}" Margin="4,0" Padding="10,7"/>
                                        <Button Grid.Column="2" Content="보고용 복사" Command="{Binding CopyReportCommand}" Background="#12A594" Margin="4,0,0,0" Padding="10,7"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="1" Margin="0,10,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="생성시간순 상담 목록" FontSize="12" FontWeight="Bold" Foreground="#344054" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="선택 삭제" Command="{Binding DeleteSelectedMemoCommand}" Style="{StaticResource DangerButton}" Margin="0,0,6,0"/>
                                <Button Grid.Column="2" Content="전체 초기화" Command="{Binding ClearAllMemosCommand}" Style="{StaticResource DangerButton}"/>
                            </Grid>

                            <ListBox Grid.Row="2" ItemsSource="{Binding Memos}" SelectedItem="{Binding SelectedMemo}"
                                     BorderBrush="#E2E7F0" Background="#FFFCF5" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="5,3"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#F2E3C5" BorderThickness="0,0,0,1" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding BusinessName}" FontWeight="Bold" FontSize="13" Foreground="#3E3425"/>
                                                    <TextBlock Text="{Binding PhoneNumber}" FontSize="10" Foreground="#8A7453" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding BusinessRegistrationNumber}" FontSize="10" Foreground="#8A7453" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Inquiry}" FontSize="11" Foreground="#5F5545" Margin="0,5,12,0"
                                                               TextTrimming="CharacterEllipsis" MaxHeight="36" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}}" FontSize="10" Foreground="#A88A59"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="▣" FontSize="15" Margin="0,0,6,0"/><TextBlock Text="복붙 친구"/></StackPanel>
                        </TabItem.Header>
                        <Grid Margin="4,10,4,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="White" BorderBrush="#DDE5F3" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="문장 이름" Foreground="#667085" FontSize="10" Margin="1,0,0,4"/>
                                    <TextBox Text="{Binding SnippetTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="예: 배송 안내"/>
                                    <TextBlock Text="문장 내용  ·  빈칸이 필요한 자리에 ``를 넣으세요" Foreground="#667085" FontSize="10" Margin="1,9,0,4"/>
                                    <TextBox Text="{Binding SnippetTemplate, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="90" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                             ToolTip="예: `` 상품은 ``일 출고 예정입니다."/>
                                    <Button Content="자주 쓰는 문장 등록" Command="{Binding SaveSnippetCommand}" Margin="0,9,0,0" Background="#5C6AC4"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Row="1" Text="등록 문장  ·  버튼을 누르면 복사됩니다" FontSize="12" FontWeight="Bold" Foreground="#344054" Margin="2,12,0,7"/>
                            <ListBox Grid.Row="2" ItemsSource="{Binding Snippets}" BorderBrush="#DDE5F3" Background="#F8FAFF" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="5,3"/></Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#E3E8F4" BorderThickness="0,0,0,1" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#344054"/>
                                                    <TextBlock Text="{Binding Template}" TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis" Foreground="#667085" FontSize="11" Margin="0,4,10,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="복사/입력" Command="{Binding DataContext.CopySnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#5C6AC4" Padding="9,6" Margin="0,0,5,0"/>
                                                    <Button Content="×" ToolTip="문장 삭제" Command="{Binding DataContext.DeleteSnippetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="9,6"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="✓" FontSize="15" Margin="0,0,6,0"/><TextBlock Text="업무 친구"/></StackPanel>
                        </TabItem.Header>
                        <Grid Margin="4,10,4,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="White" BorderBrush="#DCEAE4" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="잠시 멈춘 업무를 짧게 적어두세요" Foreground="#667085" FontSize="11" Margin="1,0,0,6"/>
                                    <TextBox Text="{Binding WorkMemoText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="82" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                             ToolTip="예: 거래처 A 견적서 3번 항목 확인 중"/>
                                    <Button Content="진행 중 업무 기억하기" Command="{Binding SaveWorkMemoCommand}" Margin="0,9,0,0" Background="#16856B"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Row="1" Text="진행 중 업무  ·  완료하면 체크하세요" FontSize="12" FontWeight="Bold" Foreground="#344054" Margin="2,12,0,7"/>
                            <ListBox Grid.Row="2" ItemsSource="{Binding WorkMemos}" BorderBrush="#DCEAE4" Background="#F6FCF9" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="5,3"/></Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="#DCEAE4" BorderThickness="0,0,0,1" Padding="11">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <CheckBox VerticalAlignment="Top" Margin="0,2,10,0" ToolTip="업무 완료"
                                                          Command="{Binding DataContext.CompleteWorkMemoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Content}" TextWrapping="Wrap" Foreground="#344054"/>
                                                <TextBlock Grid.Column="2" Text="{Binding CreatedAt, StringFormat={}{0:MM-dd HH:mm}}" FontSize="10" Foreground="#7E938B" Margin="8,2,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>

                <Border Grid.Row="2" Background="#FFF5DD" CornerRadius="0,0,15,15" Padding="14,9">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#7A5B2E" FontSize="10" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
