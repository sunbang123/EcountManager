<Window x:Class="EcountManager.TransparencyControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="화면 가리지 않기" Icon="Assets/EcountManager.ico"
        Width="282" Height="58" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" Cursor="SizeAll"
        PreviewMouseLeftButtonDown="Window_OnPreviewMouseLeftButtonDown">
    <ToggleButton x:Name="TransparencyToggle" Margin="1" IsHitTestVisible="False"
                  Cursor="Hand" ToolTip="Ecount Manager와 메모 친구들을 완전히 투명하게 전환">
        <ToggleButton.Template>
            <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="ToggleBorder" Background="#F7102A5C" BorderBrush="#F79009"
                        BorderThickness="2" CornerRadius="12" Padding="9,5">
                    <Border.Effect>
                        <DropShadowEffect Color="#F79009" BlurRadius="14" ShadowDepth="0" Opacity="0.65"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PowerCircle" Width="34" Height="34" CornerRadius="17" Background="#F79009">
                            <TextBlock Text="⏻" Foreground="White" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="화면 가리지 않기" Foreground="White" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="작업 창을 완전히 투명하게" Foreground="#FFD58C" FontSize="9"/>
                        </StackPanel>
                        <Border x:Name="StatePill" Grid.Column="2" Background="#B42318" CornerRadius="11"
                                Padding="9,4" VerticalAlignment="Center" Margin="8,0,2,0">
                            <TextBlock x:Name="ToggleState" Text="OFF" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="ToggleBorder" Property="Background" Value="#F7103B32"/>
                        <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#12B76A"/>
                        <Setter TargetName="PowerCircle" Property="Background" Value="#12B76A"/>
                        <Setter TargetName="StatePill" Property="Background" Value="#12B76A"/>
                        <Setter TargetName="ToggleState" Property="Text" Value="ON"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </ToggleButton.Template>
    </ToggleButton>
</Window>
