<Window x:Class="EcountManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ecount Manager" Icon="Assets/EcountManager.ico" Width="1450" Height="850"
        MinWidth="1120" MinHeight="700" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="SmallLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PageBackgroundBrush}" BorderBrush="#31558F" BorderThickness="1" CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Background="#102A5C" CornerRadius="13,13,0,0" MouseLeftButtonDown="WindowHeader_OnMouseLeftButtonDown" Cursor="SizeAll">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="ECOUNT MANAGER" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="드래그해서 이동 · Ctrl+1로 표시/숨김" Foreground="#AFC6F4" FontSize="9" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

        <Border Background="#102A5C">
            <Grid Margin="22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="ECOUNT MANAGER" Foreground="White" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="검색할 때만 호출하는 재고 뷰어" Foreground="#AFC6F4" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,24,0,0" Background="#17376B" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Ecount 연결" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,14"/>
                        <TextBlock Text="회사코드" Foreground="#D7E3FA" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding CompanyCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Margin="0,0,0,12"/>
                        <TextBlock Text="인증키 발급 ID" Foreground="#D7E3FA" FontSize="11" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding UserId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                        <TextBlock Text="API 인증키" Foreground="#D7E3FA" FontSize="11" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_OnPasswordChanged" Padding="12,9" Margin="0,0,0,12"/>
                        <CheckBox Content="테스트 서버 사용" IsChecked="{Binding UseTestServer}" Foreground="White" Margin="0,0,0,14"/>
                        <Button Content="Ecount 연결만 하기" Command="{Binding ConnectCommand}"/>
                        <TextBlock Text="인증키는 메모리에만 보관되며 파일에 저장되지 않습니다."
                                   Foreground="#9FB9E8" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <TextBlock Text="연결 상태" Foreground="#8FB3F4" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="White" TextWrapping="Wrap" Margin="0,7,0,0"/>
                    <TextBlock Foreground="#B9CBEB" FontSize="11" Margin="0,10,0,0">
                        <Run Text="Zone  "/><Run Text="{Binding Zone, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ServerMode, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border Background="#17376B" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                        <TextBlock Text="메모 친구들은 리모컨에서 켜고 끌 수 있습니다." Foreground="#D7E3FA"
                                   FontSize="10" TextAlignment="Center" TextWrapping="Wrap"/>
                    </Border>
                    <TextBlock Text="검색 버튼을 누를 때만 API 호출" Foreground="#AFC6F4" FontSize="10" TextAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,20,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="품목코드 단건 조회" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="연결 후 정확한 품목코드를 검색할 때만 Ecount API를 호출합니다." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="현재 품목 다시 조회" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}"><StackPanel>
                    <TextBlock Text="조회 품목 수" Style="{StaticResource SmallLabel}"/>
                    <TextBlock Text="{Binding ProductCount, StringFormat={}{0:N0}개}" Style="{StaticResource SummaryValue}"/>
                </StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel>
                    <TextBlock Text="전체 재고 수량" Style="{StaticResource SmallLabel}"/>
                    <TextBlock Text="{Binding TotalStock, StringFormat={}{0:N0}}" Style="{StaticResource SummaryValue}"/>
                </StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}"><StackPanel>
                    <TextBlock Text="최근 동기화" Style="{StaticResource SmallLabel}"/>
                    <TextBlock Text="{Binding LastSyncedAt, StringFormat={}{0:MM-dd HH:mm}, TargetNullValue=-}" Style="{StaticResource SummaryValue}"/>
                </StackPanel></Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="정확한 Ecount 품목코드를 입력하세요. 입력만으로는 API가 호출되지 않습니다.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Grid.Column="1" Content="품목 조회" Command="{Binding SearchCommand}" Margin="10,0,0,0" MinWidth="110"/>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
                <TabControl BorderThickness="0" Margin="14,8,14,14">
                    <TabItem Header="품목 · 전체 재고">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="그룹 설정 목록" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding SelectedGroup}"
                                          Width="240" Padding="9,6" ToolTip="검색해 둔 품목의 Ecount 그룹코드 목록"/>
                                <TextBlock Text="검색한 품목의 그룹만 자동으로 표시됩니다." VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="12,0,0,0"/>
                            </StackPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ProductsView}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="품목코드" Binding="{Binding Code}" Width="180"/>
                                    <DataGridTextColumn Header="품목명" Binding="{Binding Name}" Width="*" MinWidth="260"/>
                                    <DataGridTextColumn Header="단가" Binding="{Binding SalesPrice, StringFormat=N0}" Width="170"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="창고별 재고">
                        <DataGrid ItemsSource="{Binding WarehouseStocksView}" Margin="0,14,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="창고코드" Binding="{Binding WarehouseCode}" Width="105"/>
                                <DataGridTextColumn Header="창고명" Binding="{Binding WarehouseName}" Width="150"/>
                                <DataGridTextColumn Header="품목코드" Binding="{Binding ProductCode}" Width="115"/>
                                <DataGridTextColumn Header="품목명" Binding="{Binding ProductName}" Width="*" MinWidth="220"/>
                                <DataGridTextColumn Header="규격" Binding="{Binding Specification}" Width="200"/>
                                <DataGridTextColumn Header="재고수량" Binding="{Binding Quantity, StringFormat=N2}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="공식 API 범위 안내">
                        <StackPanel Margin="24">
                            <TextBlock Text="현재 연동 범위" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="• Zone 조회 및 로그인 세션&#x0a;• 품목 조회&#x0a;• 재고 현황 조회&#x0a;• 창고별 재고 현황 조회"
                                       FontSize="14" LineHeight="28" Margin="0,14,0,0"/>
                            <TextBlock Text="판매 이력, 거래처 채권, 고객별 최근 판매가는 공식 조회 API가 없어 표시하지 않습니다."
                                       Foreground="{StaticResource WarningBrush}" Margin="0,18,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <TextBlock Grid.Row="4" Text="연결만 해서는 데이터를 불러오지 않습니다. 정확한 품목코드를 입력하고 조회 버튼 또는 Enter를 누르세요."
                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="2,10,0,0"/>
        </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
