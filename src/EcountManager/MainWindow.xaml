<Window x:Class="EcountManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ecount Manager" Width="1500" Height="900"
        MinWidth="1180" MinHeight="720" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="294" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#102A5C">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="84" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="22,18,18,12">
                    <TextBlock Text="ECOUNT MANAGER" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="영업 상담 통합 뷰어" Foreground="#AFC6F4" FontSize="12" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="18,10,18,14">
                    <TextBlock Text="고객 검색" Foreground="#D7E3FA" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,8" />
                    <TextBox Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="상호명, 전화번호 또는 고객코드" />
                </StackPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding CustomersView}" SelectedItem="{Binding SelectedCustomer}"
                         Margin="12,0" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="Padding" Value="12" />
                            <Setter Property="Margin" Value="0,3" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2457D6" /></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A3B70" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Foreground="#B9CBEB" FontSize="11" Margin="0,5,0,0">
                                    <Run Text="{Binding Code}"/><Run Text="  ·  "/><Run Text="{Binding Phone}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="3" BorderBrush="#294679" BorderThickness="0,1,0,0" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="읽기 전용" Foreground="#8FB3F4" FontSize="11" FontWeight="Bold" />
                        <TextBlock Text="주문 등록은 Ecount 웹에서 진행합니다." Foreground="#B9CBEB" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,18,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedCustomer.Name, FallbackValue=고객을 선택하세요}" FontSize="26" FontWeight="Bold" />
                    <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0">
                        <Run Text="{Binding SelectedCustomer.Group}"/><Run Text="  ·  담당 영업 "/><Run Text="{Binding SelectedCustomer.SalesManager}"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding RefreshCommand}" Content="새로고침" VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/>
                    <ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}"><StackPanel>
                    <TextBlock Text="현재 채권" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding Dashboard.OutstandingBalance, StringFormat={}{0:N0} 원}" Style="{StaticResource ValueStyle}" Foreground="{StaticResource WarningBrush}"/>
                </StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}"><StackPanel>
                    <TextBlock Text="최근 판매일" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding Dashboard.LastSaleDate, StringFormat={}{0:yyyy-MM-dd}, TargetNullValue=-}" Style="{StaticResource ValueStyle}"/>
                </StackPanel></Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}"><StackPanel>
                    <TextBlock Text="최근 조회 매출" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding Dashboard.RecentSalesTotal, StringFormat={}{0:N0} 원}" Style="{StaticResource ValueStyle}"/>
                </StackPanel></Border>
                <Border Grid.Column="6" Style="{StaticResource CardStyle}"><StackPanel>
                    <TextBlock Text="여신 한도" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Text="{Binding SelectedCustomer.CreditLimit, StringFormat={}{0:N0} 원}" Style="{StaticResource ValueStyle}"/>
                </StackPanel></Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="신규 주문 빠른 확인" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="재고와 고객 최근 단가를 즉시 확인합니다." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding InventorySearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="품목명, 품목코드, 규격 또는 가격" MinWidth="300"/>
                    <Button Grid.Column="2" Content="재고·가격 보기" Command="{Binding OpenInventoryTabCommand}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
                <TabControl SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Margin="14,8,14,14">
                    <TabItem Header="판매 이력">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                            <TextBox Text="{Binding SaleSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="품목, 규격, 금액, 담당자 또는 전표번호" Margin="0,0,0,10"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SalesView}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="판매일" Binding="{Binding SaleDate, StringFormat=yyyy-MM-dd}" Width="105"/>
                                    <DataGridTextColumn Header="전표번호" Binding="{Binding SlipNumber}" Width="135"/>
                                    <DataGridTextColumn Header="품목" Binding="{Binding ItemName}" Width="*" MinWidth="160"/>
                                    <DataGridTextColumn Header="규격" Binding="{Binding Specification}" Width="180"/>
                                    <DataGridTextColumn Header="수량" Binding="{Binding Quantity, StringFormat=N0}" Width="75"/>
                                    <DataGridTextColumn Header="단가" Binding="{Binding UnitPrice, StringFormat=N0}" Width="105"/>
                                    <DataGridTextColumn Header="합계" Binding="{Binding TotalAmount, StringFormat=N0}" Width="120"/>
                                    <DataGridTextColumn Header="입력 담당자" Binding="{Binding EnteredBy}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="신규 주문 · 재고/가격">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="기준 판매가와 이 고객의 최근 구매단가를 비교하세요. 최종 주문 전 Ecount 웹에서 다시 확인해야 합니다."
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding InventoryView}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="품목코드" Binding="{Binding ItemCode}" Width="105"/>
                                    <DataGridTextColumn Header="품목" Binding="{Binding ItemName}" Width="*" MinWidth="170"/>
                                    <DataGridTextColumn Header="규격" Binding="{Binding Specification}" Width="180"/>
                                    <DataGridTextColumn Header="현재고" Binding="{Binding CurrentStock, StringFormat=N0}" Width="75"/>
                                    <DataGridTextColumn Header="상태" Binding="{Binding StockStatus}" Width="90"/>
                                    <DataGridTextColumn Header="기준 판매가" Binding="{Binding StandardPrice, StringFormat=N0}" Width="115"/>
                                    <DataGridTextColumn Header="최근 구매단가" Binding="{Binding LastCustomerPrice, StringFormat=N0, TargetNullValue=-}" Width="120"/>
                                    <DataGridTextColumn Header="최근 수량" Binding="{Binding LastOrderQuantity, StringFormat=N0, TargetNullValue=-}" Width="90"/>
                                    <DataGridTextColumn Header="최근 판매일" Binding="{Binding LastSaleDate, StringFormat=yyyy-MM-dd, TargetNullValue=-}" Width="105"/>
                                    <DataGridTextColumn Header="부가세" Binding="{Binding TaxLabel}" Width="95"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="채권 내역">
                        <DataGrid Margin="0,14,0,0" ItemsSource="{Binding ReceivablesView}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="일자" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="110"/>
                                <DataGridTextColumn Header="구분" Binding="{Binding Type}" Width="75"/>
                                <DataGridTextColumn Header="참조번호" Binding="{Binding ReferenceNumber}" Width="150"/>
                                <DataGridTextColumn Header="내용" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="발생" Binding="{Binding Debit, StringFormat=N0}" Width="120"/>
                                <DataGridTextColumn Header="입금" Binding="{Binding Credit, StringFormat=N0}" Width="120"/>
                                <DataGridTextColumn Header="잔액" Binding="{Binding Balance, StringFormat=N0}" Width="130"/>
                                <DataGridTextColumn Header="담당자" Binding="{Binding EnteredBy}" Width="95"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="고객 정보">
                        <Grid Margin="12,22">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition/><ColumnDefinition Width="140"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/><RowDefinition Height="46"/></Grid.RowDefinitions>
                            <TextBlock Text="고객코드" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding SelectedCustomer.Code}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="대표자" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding SelectedCustomer.Representative}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Text="전화번호" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedCustomer.Phone}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="소비자 그룹" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedCustomer.Group}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="담당 영업" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCustomer.SalesManager}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="여신 한도" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedCustomer.CreditLimit, StringFormat={}{0:N0} 원}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Text="주소" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding SelectedCustomer.Address}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <Grid Grid.Row="4" Margin="2,10,2,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="샘플 데이터 모드" Foreground="{StaticResource WarningBrush}" FontSize="11" FontWeight="SemiBold"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
